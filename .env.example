# Public site URL (used for metadataBase, canonical URLs, sitemap)
NEXT_PUBLIC_SITE_URL=https://jimzaslaw.com

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Contact form submissions are handled by Netlify Forms — no env vars needed.
